<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>__ADDIN_ID__</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Yoraito</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="__TOOL_NAME__"/>
  <Description DefaultValue="__TOOL_DESCRIPTION__"/>
  <IconUrl DefaultValue="http://localhost:__PORT__/static/icon.png"/>
  <HighResolutionIconUrl DefaultValue="http://localhost:__PORT__/static/icon.png"/>
  <SupportUrl DefaultValue="https://github.com/YoraitoAI/__TOOL_NAME_LOWER__"/>
  <AppDomains>
    <AppDomain>localhost</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="http://localhost:__PORT__/static/excel-addin.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
