<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>__TOOL_NAME__</title>
<script src="https://appsforoffice.microsoft.com/lib/1/hosted/office.js"></script>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 15px; margin: 0; }
  h2 { color: #4361ee; font-size: 1.2rem; }
  .btn { background: #4361ee; color: white; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; margin: 5px 0; width: 100%; font-size: 0.95rem; }
  .btn:hover { background: #3a56d4; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .status { margin: 10px 0; padding: 10px; border-radius: 6px; font-size: 0.9rem; }
  .status.info { background: #e7f3ff; color: #004085; }
  .status.error { background: #f8d7da; color: #721c24; }
  .status.success { background: #d4edda; color: #155724; }
  .status.warning { background: #fff3cd; color: #856404; }
  input[type="file"] { margin: 10px 0; width: 100%; }
  .result-link { display: block; text-align: center; margin: 15px 0; padding: 12px; background: #28a745; color: white; border-radius: 6px; text-decoration: none; font-weight: bold; }
  .server-status { font-size: 0.8rem; color: #666; margin-top: 10px; }
  .server-status.online { color: #28a745; }
  .server-status.offline { color: #dc3545; }
</style>
</head>
<body>
  <h2>__TOOL_NAME__</h2>
  <p style="font-size: 0.9rem; color: #666; margin-bottom: 15px;">__TOOL_DESCRIPTION__. 100% local.</p>

  <div id="status" class="status info">Checking server...</div>
  <div id="server-check" class="server-status">Server: checking...</div>

  <button class="btn" id="btn-compare" onclick="startCompare()">Compare with Another File...</button>

  <div id="file-picker" style="display:none; margin-top: 15px;">
    <p style="font-size: 0.9rem;">Select the second file:</p>
    <input type="file" id="file-b" accept="__FILE_ACCEPT__">
    <button class="btn" id="btn-run" onclick="runDiff()">Run</button>
  </div>

  <div id="result-area" style="display:none; margin-top: 15px;">
    <a id="result-link" class="result-link" href="#" target="_blank">View Results in Browser</a>
  </div>

  <script>
    const SERVER = 'http://localhost:__PORT__';
    const API_ENDPOINT = '__API_ENDPOINT__';

    Office.onReady(function(info) {
      checkServer();
    });

    async function checkServer() {
      try {
        const resp = await fetch(SERVER + '/api/health', { mode: 'cors' });
        if (resp.ok) {
          document.getElementById('server-check').textContent = 'Server: online';
          document.getElementById('server-check').className = 'server-status online';
          document.getElementById('status').textContent = 'Ready.';
          document.getElementById('status').className = 'status info';
        } else { throw new Error('Not responding'); }
      } catch (e) {
        document.getElementById('server-check').textContent = 'Server: offline';
        document.getElementById('server-check').className = 'server-status offline';
        document.getElementById('status').textContent = 'Start the server first: __CLI_COMMAND__-web';
        document.getElementById('status').className = 'status warning';
      }
    }

    function startCompare() {
      document.getElementById('file-picker').style.display = 'block';
      document.getElementById('status').textContent = 'Select the second file.';
      document.getElementById('status').className = 'status info';
    }

    async function runDiff() {
      const fileB = document.getElementById('file-b').files[0];
      if (!fileB) { alert('Please select a file'); return; }
      document.getElementById('status').textContent = 'Reading workbook...';
      document.getElementById('status').className = 'status info';
      document.getElementById('btn-run').disabled = true;

      try {
        const fileA = await getWorkbookAsFile();
        if (!fileA) throw new Error('Could not read current workbook');

        document.getElementById('status').textContent = 'Running...';
        const formData = new FormData();
        formData.append('file_a', fileA, 'current_workbook.xlsx');
        formData.append('file_b', fileB);

        const response = await fetch(SERVER + API_ENDPOINT, { method: 'POST', body: formData, mode: 'cors' });
        if (!response.ok) {
          const err = await response.json();
          throw new Error(err.detail || 'Failed');
        }
        const data = await response.json();
        document.getElementById('status').textContent = 'Done! ' + (data.summary?.total_changes || data.matches || '') + ' changes found.';
        document.getElementById('status').className = 'status success';
        document.getElementById('result-area').style.display = 'block';
        document.getElementById('result-link').href = SERVER;
      } catch (e) {
        document.getElementById('status').textContent = 'Error: ' + e.message;
        document.getElementById('status').className = 'status error';
      } finally {
        document.getElementById('btn-run').disabled = false;
      }
    }

    async function getWorkbookAsFile() {
      return new Promise((resolve) => {
        Office.context.document.getFileAsync(Office.FileType.Compressed, { sliceSize: 65536 }, function(result) {
          if (result.status === Office.AsyncResultStatus.Succeeded) {
            const file = result.value;
            const slices = [];
            let index = 0;
            function readNextSlice() {
              file.getSliceAsync(index, function(sliceResult) {
                if (sliceResult.status === Office.AsyncResultStatus.Succeeded) {
                  slices.push(sliceResult.value.data);
                  index++;
                  if (index < file.sliceCount) { readNextSlice(); }
                  else {
                    file.closeAsync();
                    resolve(new Blob(slices, { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }));
                  }
                } else { file.closeAsync(); resolve(null); }
              });
            }
            readNextSlice();
          } else { resolve(null); }
        });
      });
    }
  </script>
</body>
</html>
